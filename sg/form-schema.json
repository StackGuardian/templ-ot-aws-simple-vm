    "instance_type": {
      "type": "string",
      "default": "t3.micro",
      "enum": [
        "t3.micro",
        "t3.small",
        "t3.medium",
        "t3.large",
        "t3.xlarge",
        "t3a.micro",
        "t3a.small",
        "t3a.medium",
        "t3a.large",
        "m6i.large",
        "m6i.xlarge",
        "m7i.large",
        "m7i.xlarge",
        "m7a.large"
      ],
      "enumNames": [
        "t3.micro (2 vCPU, 1 GiB)",
        "t3.small (2 vCPU, 2 GiB)",
        "t3.medium (2 vCPU, 4 GiB)",
        "t3.large (2 vCPU, 8 GiB)",
        "t3.xlarge (4 vCPU, 16 GiB)",
        "t3a.micro (2 vCPU, 1 GiB)",
        "t3a.small (2 vCPU, 2 GiB)",
        "t3a.medium (2 vCPU, 4 GiB)",
        "t3a.large (2 vCPU, 8 GiB)",
        "m6i.large (2 vCPU, 8 GiB)",
        "m6i.xlarge (4 vCPU, 16 GiB)",
        "m7i.large (2 vCPU, 8 GiB)",
        "m7i.xlarge (4 vCPU, 16 GiB)",
        "m7a.large (2 vCPU, 8 GiB)"
      ]
    },
    "ssh_public_key": {
      "type": "string",
      "description": "RSA or ED25519 public key for SSH login with a public IP, for example ssh-ed25519 AAAA... Leave empty to use only Session Manager",
      "pattern": "^((ssh-ed25519|ssh-rsa) .+)?$"
    },
    "advanced_settings": {
      "type": "object",
      "properties": {
        "show_advanced_settings": {
          "type": "boolean",
          "default": false
        }
      },
      "dependencies": {
        "show_advanced_settings": {
          "oneOf": [
            {
              "properties": {
                "show_advanced_settings": {
                  "enum": [
                    false
                  ]
                }
              },
              "required": []
            },
            {
              "properties": {
                "show_advanced_settings": {
                  "enum": [
                    true
                  ]
                },
                "vpc_cidr": {
                  "title": "VPC cidr",
                  "type": "string",
                  "description": "CIDR block of the VPC",
                  "default": "10.0.0.0/16"
                },
                "enable_public_ip": {
                  "title": "Enable public ip",
                  "type": "boolean",
                  "description": "Place the instance in the public subnet and attach an Elastic IP",
                  "default": false
                },
                "allowed_ingress_cidrs": {
                  "title": "Allowed ingress cidrs",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "IPv4 CIDRs allowed to reach the instance when the public IP is enabled",
                  "default": []
                },
                "allowed_ingress_ports": {
                  "title": "Allowed ingress ports",
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "TCP ports opened for allowed_ingress_cidrs when the public IP is enabled",
                  "default": [
                    22
                  ]
                },
                "log_retention_days": {
                  "title": "Log retention days",
                  "type": "number",
                  "description": "Retention of the VPC flow logs in CloudWatch",
                  "default": 90,
                  "enum": [
                    1,
                    3,
                    5,
                    7,
                    14,
                    30,
                    60,
                    90,
                    120,
                    150,
                    180,
                    365,
                    400,
                    545,
                    731,
                    1096,
                    1827,
                    2192,
                    2557,
                    2922,
                    3288,
                    3653
                  ],
                  "enumNames": [
                    "1 day",
                    "3 days",
                    "5 days",
                    "7 days",
                    "14 days",
                    "30 days",
                    "60 days",
                    "90 days",
                    "120 days",
                    "150 days",
                    "180 days",
                    "365 days",
                    "400 days",
                    "545 days",
                    "731 days",
                    "1096 days",
                    "1827 days",
                    "2192 days",
                    "2557 days",
                    "2922 days",
                    "3288 days",
                    "3653 days"
                  ]
                },
                "tags": {
                  "title": "Tags",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Additional tags for all resources",
                  "default": {}
                }
              },
              "required": []
            }
          ]
        }
      }
    }
  },
  "title": "AWS Virtual Machine (EC2)"
}
