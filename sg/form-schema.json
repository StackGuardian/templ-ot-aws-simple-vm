{
  "type": "object",
  "required": [],
  "properties": {
    "name_prefix": {
      "title": "Name prefix",
      "type": "string",
      "description": "Prefix for all resource names",
      "default": "demo",
      "pattern": "^[a-z][a-z0-9-]{1,15}$"
    },
    "region": {
      "title": "Region",
      "type": "string",
      "description": "AWS region",
      "default": "eu-central-1"
    },
    "tags": {
      "title": "Tags",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Additional tags for all resources",
      "default": {}
    },
    "instance_type": {
      "title": "Instance type",
      "type": "string",
      "description": "EC2 instance type (x86_64)",
      "default": "t3.micro"
    },
    "vpc_cidr": {
      "title": "VPC cidr",
      "type": "string",
      "description": "CIDR block of the VPC",
      "default": "10.0.0.0/16"
    },
    "enable_public_ip": {
      "title": "Enable public ip",
      "type": "boolean",
      "description": "Place the instance in the public subnet and attach an Elastic IP",
      "default": false
    },
    "allowed_ingress_cidrs": {
      "title": "Allowed ingress cidrs",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IPv4 CIDRs allowed to reach the instance when the public IP is enabled",
      "default": []
    },
    "allowed_ingress_ports": {
      "title": "Allowed ingress ports",
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "TCP ports opened for allowed_ingress_cidrs when the public IP is enabled",
      "default": [
        22
      ]
    },
    "ssh_public_key": {
      "title": "SSH public key",
      "type": "string",
      "description": "SSH public key for the ec2-user. Leave null to use SSM Session Manager only."
    },
    "log_retention_days": {
      "title": "Log retention days",
      "type": "number",
      "description": "Retention of the VPC flow logs in CloudWatch",
      "default": 90,
      "enum": [
        1,
        3,
        5,
        7,
        14,
        30,
        60,
        90,
        120,
        150,
        180,
        365,
        400,
        545,
        731,
        1096,
        1827,
        2192,
        2557,
        2922,
        3288,
        3653
      ]
    }
  },
  "title": "AWS Virtual Machine (EC2)"
}
